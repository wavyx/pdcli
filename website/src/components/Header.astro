---
// Clarity nav (design/dir-clarity.jsx) — replaces Starlight's default header.
// Keeps Search + SocialIcons from Starlight; swaps ThemeSelect for the
// design's single icon toggle (same `starlight-theme` localStorage contract).
import Search from 'virtual:starlight/components/Search';
import SocialIcons from 'virtual:starlight/components/SocialIcons';

const base = import.meta.env.BASE_URL;
const withBase = (path: string) => `${base}/${path}`.replace(/\/{2,}/g, '/');

const links = [
  { label: 'Docs', href: withBase('start/quickstart/') },
  { label: 'Commands', href: withBase('reference/commands/') },
  { label: 'Guides', href: withBase('guides/authentication/') },
  { label: 'Changelog', href: 'https://github.com/wavyx/pdcli/releases' },
];
---

<div class="pd-header">
  <a class="pd-mark" href={withBase('/')}>
    <span class="pd-mark__chip" aria-hidden="true">
      <svg
        width="16"
        height="16"
        viewBox="0 0 24 24"
        fill="none"
        stroke="#fff"
        stroke-width="2.4"
        stroke-linecap="round"
        stroke-linejoin="round"><path d="M4 17l5-5-5-5"></path><path
          d="M12 19h8"></path></svg>
    </span>
    <span class="pd-mark__txt"><b>pd</b>cli</span>
  </a>
  <nav class="pd-nav-links" aria-label="Main">
    {links.map((l) => <a href={l.href}>{l.label}</a>)}
  </nav>
  <div class="pd-header__sp"></div>
  <div class="pd-header__search print:hidden"><Search /></div>
  <button
    class="pd-iconbtn pd-theme-toggle print:hidden"
    type="button"
    aria-label="Toggle color theme"
  >
    <span class="pd-theme-toggle__dark" aria-hidden="true">
      {/* sun — shown in dark mode, switches to light */}
      <svg
        width="17"
        height="17"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.8"
        stroke-linecap="round"
        ><circle cx="12" cy="12" r="4.2"></circle><path
          d="M12 2v2M12 20v2M4.2 4.2l1.4 1.4M18.4 18.4l1.4 1.4M2 12h2M20 12h2M4.2 19.8l1.4-1.4M18.4 5.6l1.4-1.4"
        ></path></svg>
    </span>
    <span class="pd-theme-toggle__light" aria-hidden="true">
      {/* moon — shown in light mode, switches to dark */}
      <svg
        width="17"
        height="17"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.8"
        stroke-linecap="round"><path d="M21 12.8A9 9 0 1111.2 3 7 7 0 0021 12.8z"></path></svg>
    </span>
  </button>
  <div class="pd-header__social print:hidden"><SocialIcons /></div>
  <a class="pd-btn-primary print:hidden" href={withBase('start/quickstart/')}
    >Get started</a
  >
</div>

<script>
  // Light/dark toggle wired to Starlight's theme storage so the docs
  // pages, code themes, and any pickers all stay in sync.
  const toggle = document.querySelector('.pd-theme-toggle');
  const label = () =>
    document.documentElement.dataset.theme === 'dark'
      ? 'Switch to light theme'
      : 'Switch to dark theme';
  if (toggle instanceof HTMLButtonElement) {
    toggle.setAttribute('aria-label', label());
    toggle.addEventListener('click', () => {
      const next =
        document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
      document.documentElement.dataset.theme = next;
      toggle.setAttribute('aria-label', label());
      try {
        localStorage.setItem('starlight-theme', next);
      } catch {
        /* storage blocked (private mode) — in-page toggle still works */
      }
      // Keep any Starlight pickers (mobile menu) in sync.
      (window as any).StarlightThemeProvider?.updatePickers?.(next);
    });
  }
</script>

<style>
  .pd-header {
    display: flex;
    align-items: center;
    gap: 1rem;
    height: 100%;
  }
  .pd-mark {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    text-decoration: none;
    flex: none;
  }
  .pd-mark__chip {
    width: 30px;
    height: 30px;
    border-radius: 9px;
    display: grid;
    place-items: center;
    flex: none;
    background: linear-gradient(145deg, var(--pd-green-bright), var(--pd-green));
    box-shadow: 0 5px 14px -5px rgba(26, 122, 76, 0.6);
  }
  .pd-mark__txt {
    font-weight: 800;
    font-size: 17px;
    letter-spacing: -0.02em;
    color: var(--sl-color-white);
    font-family: var(--sl-font-mono);
  }
  .pd-mark__txt b {
    color: var(--pd-green);
    font-weight: 800;
  }
  .pd-nav-links {
    display: flex;
    gap: 6px;
  }
  .pd-nav-links a {
    color: var(--sl-color-gray-3);
    font-weight: 600;
    font-size: 14px;
    padding: 7px 11px;
    border-radius: 8px;
    text-decoration: none;
    transition: 0.15s;
    white-space: nowrap;
  }
  .pd-nav-links a:hover {
    color: var(--sl-color-white);
    background: var(--sl-color-gray-6);
  }
  .pd-header__sp {
    flex: 1;
  }
  .pd-header__search {
    display: contents;
  }
  .pd-iconbtn {
    width: 36px;
    height: 36px;
    display: grid;
    place-items: center;
    border-radius: 9px;
    border: 1px solid transparent;
    background: transparent;
    color: var(--sl-color-gray-3);
    cursor: pointer;
    transition: 0.15s;
    flex: none;
  }
  .pd-iconbtn:hover {
    color: var(--sl-color-white);
    background: var(--sl-color-gray-6);
    border-color: var(--pd-border);
  }
  .pd-theme-toggle__dark,
  .pd-theme-toggle__light {
    display: none;
    line-height: 0;
  }
  :global([data-theme='dark']) .pd-theme-toggle__dark {
    display: block;
  }
  :global([data-theme='light']) .pd-theme-toggle__light {
    display: block;
  }
  .pd-header__social {
    display: flex;
    align-items: center;
  }
  .pd-header__social :global(a) {
    color: var(--sl-color-gray-3);
    padding: 0.25em;
  }
  .pd-header__social :global(a:hover) {
    color: var(--sl-color-white);
    opacity: 1;
  }
  .pd-btn-primary {
    display: inline-flex;
    align-items: center;
    font-weight: 700;
    font-size: 14px;
    height: 40px;
    padding: 0 18px;
    border-radius: 10px;
    white-space: nowrap;
    text-decoration: none;
    background: var(--sl-color-accent);
    color: #fff;
    box-shadow: 0 10px 24px -12px var(--sl-color-accent);
    transition: 0.15s;
    flex: none;
  }
  .pd-btn-primary:hover {
    background: var(--sl-color-accent-high);
    transform: translateY(-1px);
  }
  :global([data-theme='light']) .pd-btn-primary:hover {
    background: #4a43d4;
  }

  @media (max-width: 72rem) {
    .pd-nav-links {
      display: none;
    }
  }
  @media (max-width: 50rem) {
    .pd-btn-primary {
      display: none;
    }
  }
</style>
