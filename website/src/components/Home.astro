---
// Clarity homepage (design/dir-clarity.jsx) — all sections, stats-driven.
// Styles live in src/styles/home.css (scoped under .clr).
import stats from '../data/cli-stats.json';

const base = import.meta.env.BASE_URL;
const withBase = (path: string) => `${base}/${path}`.replace(/\/{2,}/g, '/');

const chips: [string, string][] = [
  [
    'CI pipelines',
    '<circle cx="12" cy="12" r="3"/><path d="M12 2v3M12 19v3M2 12h3M19 12h3M4.9 4.9l2.1 2.1M17 17l2.1 2.1M19.1 4.9L17 7M7 17l-2.1 2.1"/>',
  ],
  ['cron jobs', '<circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/>'],
  [
    'Slack bots',
    '<path d="M21 11.5a8.4 8.4 0 01-9 8.4L3 21l1.1-4.5A8.4 8.4 0 1121 11.5z"/>',
  ],
  ['data exports', '<path d="M12 3v11M8 10l4 4 4-4M5 21h14"/>'],
  [
    'AI agents',
    '<path d="M12 3l1.6 4.4L18 9l-4.4 1.6L12 15l-1.6-4.4L6 9l4.4-1.6z"/><path d="M18 15l.8 2.2L21 18l-2.2.8L18 21l-.8-2.2L15 18l2.2-.8z"/>',
  ],
  [
    'internal tooling',
    '<path d="M14.7 6.3a4 4 0 00-5.4 5.4L4 17l3 3 5.3-5.3a4 4 0 005.4-5.4l-2.6 2.6-2.4-2.4z"/>',
  ],
];

const steps: [string, string, string, string][] = [
  [
    '01',
    'Install',
    'npm install -g @wavyx/pdcli',
    'Node 20+. Tarballs on GitHub Releases for everything else.',
  ],
  [
    '02',
    'Authenticate',
    'pdcli auth login',
    'Prompts for your API token — stored in your OS keychain.',
  ],
  [
    '03',
    'Create',
    'pdcli deal create --title "Acme" --value 5000',
    'Your first deal, straight from the prompt.',
  ],
];

const features: { t: string; b: string; d: string }[] = [
  {
    t: 'Backup & data export',
    b: 'Stream your entire account to JSON with pdcli backup --resume, or export any resource to CSV. Resumable, scriptable, and perfect for archives or migrations.',
    d: '<ellipse cx="12" cy="6" rx="8" ry="3"/><path d="M4 6v6c0 1.7 3.6 3 8 3s8-1.3 8-3V6M4 12v6c0 1.7 3.6 3 8 3s8-1.3 8-3v-6"/>',
  },
  {
    t: 'Health reports',
    b: 'pdcli pipeline health and pdcli audit --strict surface stale deals, missing fields, and data drift — so you can keep your Pipedrive clean, accurate, and trustworthy.',
    d: '<path d="M3 12h4l2-6 4 12 2-6h6"/>',
  },
  {
    t: 'Built for AI agents',
    b: 'Self-documenting --help on every command and clean JSON output make pdcli easy for agents to discover and drive — a ready-made tool surface for your LLM workflows.',
    d: '<rect x="4" y="6" width="16" height="12" rx="2"/><path d="M9 2v4M15 2v4M9 12h0M15 12h0M9.5 15.5a3 3 0 005 0"/>',
  },
  {
    t: 'Scriptable by design',
    b: 'Stable flags, deterministic exit codes, and machine-readable output. Pipe it, branch on it, schedule it.',
    d: '<path d="M4 17l6-6-6-6"/><path d="M12 19h8"/>',
  },
  {
    t: 'JSON, jq & tables',
    b: 'Switch between human tables and JSON with one flag, then shape results inline with built-in --jq.',
    d: '<path d="M8 3H5a2 2 0 00-2 2v3M16 3h3a2 2 0 012 2v3M8 21H5a2 2 0 01-2-2v-3M16 21h3a2 2 0 002-2v-3"/>',
  },
  {
    t: 'API token or OAuth',
    b: 'Start in seconds with an API token, or run the full OAuth flow when you need it. Either way pdcli stores credentials in your OS keychain, never plaintext on disk.',
    d: '<rect x="4" y="11" width="16" height="9" rx="2"/><path d="M8 11V8a4 4 0 018 0v3"/>',
  },
];

const bandStats: [string, string, string][] = [
  [
    String(stats.commands),
    'commands',
    '<path d="M4 17l6-6-6-6"/><path d="M12 19h8"/>',
  ],
  [
    String(stats.topics),
    'topics',
    '<rect x="3" y="4" width="7" height="7" rx="1.5"/><rect x="14" y="4" width="7" height="7" rx="1.5"/><rect x="3" y="15" width="7" height="5" rx="1.5"/><rect x="14" y="15" width="7" height="5" rx="1.5"/>',
  ],
  [
    String(stats.formats),
    'output formats',
    '<path d="M8 3H5a2 2 0 00-2 2v3M16 3h3a2 2 0 012 2v3M8 21H5a2 2 0 01-2-2v-3M16 21h3a2 2 0 002-2v-3"/>',
  ],
  [
    '100%',
    'test coverage',
    '<path d="M12 2a10 10 0 100 20 10 10 0 000-20z"/><path d="M8.5 12.5l2.5 2.5 4.5-5"/>',
  ],
];

const oneLiners: [string, string][] = [
  ['Pipeline health', 'pdcli pipeline health --pipeline 1'],
  ['Import a CSV', 'pdcli person import leads.csv --dry-run'],
  [
    'Bulk update via pipe',
    "pdcli deal list --status open --jq '.[].id' | pdcli deal bulk-update --stage 5",
  ],
  ['Audit as a CI gate', 'pdcli audit --strict'],
  ['Escape hatch', 'pdcli api GET /api/v1/currencies'],
];

const check =
  '<svg aria-hidden="true" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6L9 17l-5-5"/></svg>';
const checks = [
  'Free & open source',
  'macOS, Linux & Windows',
  'API token or OAuth login',
  'Works with your existing account',
];

const showcaseTerm = `<span class="dim">$</span> <span class="g">pdcli</span> <span class="c">deal list</span> <span class="f">--status</span> open <span class="f">--limit</span> 4
<span class="dim">  ID    TITLE                 VALUE     STAGE</span>
  4821  Acme renewal          <span class="m">€12,000</span>   Negotiation
  4774  Northwind expansion   <span class="m">€ 8,500</span>   Proposal
  4710  Globex pilot          <span class="m">€ 4,200</span>   Qualified
  4699  Initech seats         <span class="m">€ 2,750</span>   Contact
<span class="dim">  4 open deals · €27,450 open value</span>

<span class="dim">$</span> <span class="g">pdcli</span> <span class="c">deal update</span> 4821 <span class="f">--status</span> won
<span class="ok">✓</span> Acme renewal → <span class="badge">Won</span> · activity logged
<span class="dim">$</span> <span class="cur">▋</span>`;
---

<div class="clr not-content">
  {/* HERO — centered */}
  <section class="clr-hero">
    <div class="clr-hero__glow"></div>
    <span class="clr-tag"
      ><i></i>v{stats.version} · {stats.commands} commands · {stats.topics} topics</span
    >
    <h1>
      Drive the whole<br /><span class="u">Pipedrive pipeline</span><br
      />from your terminal.
    </h1>
    <p class="clr-hero__lead">
      One install. Every object. <code>pdcli</code> turns deals, people, activities,
      and reports into fast, pipeable commands — for your scripts, your CI, and your
      agents.
    </p>
    <div class="clr-hero__ctas">
      <a
        class="clr-btn clr-btn--primary clr-btn--lg"
        href={withBase('start/quickstart/')}>Get started →</a
      >
      <a
        class="clr-btn clr-btn--ghost clr-btn--lg"
        href={withBase('reference/commands/')}
        >Browse {stats.commands} commands</a
      >
    </div>
    <div class="clr-aterm">
      <div class="clr-term__bar">
        <i></i><i></i><i></i><span>zsh · ~/acme</span><em>live</em>
      </div>
      <pre class="clr-term__body" id="clr-aterm-body" aria-hidden="true"><span
          class="prompt">❯</span> <span class="c" id="clr-aterm-cmd"></span><span
          class="cur">▋</span><span id="clr-aterm-out"></span></pre>
    </div>
  </section>

  {/* SCRIPTABLE STRIP */}
  <section class="clr-strip">
    <span class="clr-strip__lbl">A scriptable building block for</span>
    <div class="clr-strip__row">
      {
        chips.map(([label, icon]) => (
          <span class="clr-chip">
            <svg
              aria-hidden="true"
              width="15"
              height="15"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.7"
              stroke-linecap="round"
              stroke-linejoin="round"
              set:html={icon}
            />
            {label}
          </span>
        ))
      }
    </div>
  </section>

  {/* QUICKSTART — framed minimal */}
  <section class="clr-quick" data-quick="framed">
    <div class="clr-quick__head">
      <span class="clr-eyebrow">QUICKSTART</span>
      <h2>Three commands to your first deal</h2>
      <p>
        Install, authenticate, and create — you'll be driving your pipeline from
        the shell in under a minute.
      </p>
    </div>
    <div class="clr-quick__steps">
      {
        steps.map(([n, t, c, note], i) => (
          <>
            <div class="clr-qstep">
              <div class="clr-qstep__top">
                <span class="clr-qstep__n">{n}</span>
                <h3>{t}</h3>
              </div>
              <div class="clr-qstep__term">
                <span class="clr-qstep__p">$</span>
                <code>{c}</code>
              </div>
              <p class="clr-qstep__note">{note}</p>
            </div>
            {i < 2 && (
              <span class="clr-qstep__arrow" aria-hidden="true">
                <svg
                  width="22"
                  height="22"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <path d="M5 12h14M13 6l6 6-6 6" />
                </svg>
              </span>
            )}
          </>
        ))
      }
    </div>
    <a class="clr-quick__link" href={withBase('start/installation/')}
      >Read the full setup guide
      <svg
        aria-hidden="true"
        width="15"
        height="15"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"></path></svg>
    </a>
  </section>

  {/* FEATURES */}
  <section class="clr-section">
    <div class="clr-section__head">
      <span class="clr-eyebrow">Why pdcli</span>
      <h2>A CLI that respects your workflow</h2>
      <p>
        Predictable, composable, and quiet by default — designed to slot into
        scripts and disappear into your muscle memory.
      </p>
    </div>
    <div class="clr-grid">
      {
        features.map((f) => (
          <div class="clr-feat">
            <div class="clr-feat__ic">
              <svg
                aria-hidden="true"
                width="20"
                height="20"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.7"
                stroke-linecap="round"
                stroke-linejoin="round"
                set:html={f.d}
              />
            </div>
            <h3>{f.t}</h3>
            <p>{f.b}</p>
          </div>
        ))
      }
    </div>
  </section>

  {/* SHOWCASE */}
  <section class="clr-showcase">
    <div class="clr-showcase__copy">
      <span class="clr-eyebrow">IN PRACTICE</span>
      <h2>Close deals from the command line.</h2>
      <p class="clr-lead">
        Track your pipeline, manage deals, and log activities without leaving
        your shell — so you can spend less time clicking and more time selling.
        <code>pdcli</code> is a fast, scriptable companion for the Pipedrive API:
        {stats.commands} commands across {stats.topics} topics.
      </p>
      <div class="clr-install">
        <span class="clr-install__p">$</span>
        <span class="clr-install__cmd">npm install -g @wavyx/pdcli</span>
        <button
          class="clr-install__copy"
          type="button"
          aria-label="Copy install command"
        >
          <svg
            class="clr-install__ic-copy"
            width="15"
            height="15"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.8"
            ><rect x="9" y="9" width="11" height="11" rx="2"></rect><path
              d="M5 15V5a2 2 0 012-2h10"></path></svg>
          <svg
            class="clr-install__ic-check"
            width="15"
            height="15"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2.2"
            stroke-linecap="round"
            stroke-linejoin="round"><path d="M20 6L9 17l-5-5"></path></svg>
        </button>
      </div>
      <ul class="clr-checks">
        {
          checks.map((c) => (
            <li>
              <Fragment set:html={check} />
              {c}
            </li>
          ))
        }
      </ul>
    </div>

    <div class="clr-showcase__demo" aria-hidden="true">
      <div class="clr-term">
        <div class="clr-term__bar"><i></i><i></i><i></i><span>~/acme — pd</span></div>
        <pre class="clr-term__body" set:html={showcaseTerm} />
      </div>
    </div>
  </section>

  {/* STAT BAND */}
  <section class="clr-band">
    <div class="clr-band__grid">
      {
        bandStats.map(([n, l, ic]) => (
          <div class="clr-stat">
            <span class="clr-stat__ic">
              <svg
                aria-hidden="true"
                width="24"
                height="24"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.7"
                stroke-linecap="round"
                stroke-linejoin="round"
                set:html={ic}
              />
            </span>
            <div class="clr-stat__body">
              <span class="clr-stat__n">{n}</span>
              <span class="clr-stat__l">{l}</span>
            </div>
          </div>
        ))
      }
    </div>
  </section>

  {/* COMMAND SHOWCASE */}
  <section class="clr-section clr-section--alt">
    <div class="clr-section__head">
      <span class="clr-eyebrow">SIGNATURE MOVES</span>
      <h2>One-liners that replace a dashboard</h2>
      <p>
        Learn one pattern, run everything — real commands, copy-paste ready.
        This is what living in <code>pdcli</code> feels like.
      </p>
      <code class="clr-grammar"
        ><span class="bin">pdcli</span>
        <span class="slot">&lt;topic&gt;</span>
        <span class="slot">&lt;action&gt;</span>
        <span class="opt">[target]</span>
        <span class="opt">[flags]</span></code
      >
    </div>
    <div class="clr-cmds">
      {
        oneLiners.map(([label, cmd]) => (
          <div class="clr-cmdrow">
            <span class="clr-cmdrow__label">{label}</span>
            <code class="clr-cmdrow__code">{cmd}</code>
          </div>
        ))
      }
    </div>
  </section>

  {/* CTA */}
  <section class="clr-cta">
    <h2>Less time managing, more time closing.</h2>
    <p>Install in seconds, automate the rest. Your pipeline, one command away.</p>
    <div class="clr-cta__row">
      <a
        class="clr-btn clr-btn--primary clr-btn--lg"
        href={withBase('start/quickstart/')}>Get started</a
      >
      <a
        class="clr-btn clr-btn--ghost clr-btn--lg"
        href={withBase('reference/commands/')}>Command reference</a
      >
    </div>
  </section>
</div>

<script>
  // ── Animated hero terminal: types three real pdcli commands in a loop. ──
  const SCRIPT = [
    {
      cmd: 'pdcli pipeline health',
      out: `<span class="dim">  ┌ SALES PIPELINE ───────────────── Q2 ┐</span>
  Qualified     <span class="n">18</span> deals    <span class="m">€142,000</span>
  Contact       <span class="n">11</span> deals    <span class="m">€ 98,500</span>
  Proposal       <span class="n">7</span> deals    <span class="m">€ 76,200</span>
  Negotiation    <span class="n">4</span> deals    <span class="m">€ 51,000</span>
<span class="dim">  ─────────────────────────────────────</span>
  weighted forecast          <span class="ok">€221,480</span>
<span class="dim">  win rate 32% · avg cycle 24d</span>`,
    },
    {
      cmd: "pdcli deal list --status open --jq '.[].id' | pdcli deal bulk-update --stage 5",
      out: `<span class="ok">  ✓</span> 40 open deals moved → <span class="badge">Negotiation</span>`,
    },
    {
      cmd: 'pdcli person import leads.csv --dry-run',
      out: `  <span class="ok">+212</span> new   <span class="n">~18</span> updates   <span class="warn">!3</span> conflicts
<span class="dim">  dry run · nothing written · custom fields matched by name</span>`,
    },
  ];

  const cmdEl = document.getElementById('clr-aterm-cmd');
  const outEl = document.getElementById('clr-aterm-out');
  if (cmdEl && outEl) {
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (reduced) {
      // Static first frame, no loop.
      cmdEl.textContent = SCRIPT[0].cmd;
      outEl.innerHTML = '\n' + SCRIPT[0].out;
    } else {
      let idx = 0;
      const play = () => {
        const step = SCRIPT[idx % SCRIPT.length];
        let i = 0;
        outEl.innerHTML = '';
        cmdEl.textContent = '';
        const t = setInterval(() => {
          i++;
          cmdEl.textContent = step.cmd.slice(0, i);
          if (i >= step.cmd.length) {
            clearInterval(t);
            setTimeout(() => {
              outEl.innerHTML = '\n' + step.out;
            }, 240);
            setTimeout(() => {
              idx++;
              play();
            }, 3400);
          }
        }, 46);
      };
      play();
    }
  }

  // ── Install-command copy button. ──
  const copyBtn = document.querySelector('.clr-install__copy');
  if (copyBtn instanceof HTMLButtonElement) {
    copyBtn.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText('npm install -g @wavyx/pdcli');
      } catch {
        /* clipboard unavailable (http, permissions) — button still animates */
      }
      copyBtn.classList.add('is-copied');
      setTimeout(() => copyBtn.classList.remove('is-copied'), 1400);
    });
  }
</script>
